rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'subscriptionTier', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email is string
        && data.subscriptionTier in ['FREE', 'PRO', 'ENTERPRISE']
        && data.createdAt is string;
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['instagramId', 'pageAccessToken'])
        && data.instagramId is string && data.instagramId.size() <= 128
        && data.pageAccessToken is string && data.pageAccessToken.size() <= 4096
        && (!('username' in data) || data.username is string)
        && (!('name' in data) || data.name is string)
        && (!('isActive' in data) || data.isActive is bool)
        && (!('tokenExpiresAt' in data) || data.tokenExpiresAt is string)
        && (!('tokenType' in data) || data.tokenType is string);
    }

    function isValidRule(data) {
      return data.keys().hasAll(['triggerKeyword', 'resource'])
        && data.triggerKeyword is string && data.triggerKeyword.size() <= 64
        && data.resource is string && data.resource.size() <= 512;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUser(incoming());
      allow update: if isOwner(uid);

      match /accounts/{accountId} {
        allow list, get: if isOwner(uid);
        allow create: if isOwner(uid) && isValidAccount(incoming()) && isValidId(accountId);
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);

        match /media/{mediaId} {
          allow list, get: if isOwner(uid);
          allow write: if isOwner(uid);
        }

        match /rules/{ruleId} {
          allow list, get: if isOwner(uid);
          allow create: if isOwner(uid) && isValidRule(incoming());
          allow update: if isOwner(uid);
          allow delete: if isOwner(uid);
        }

        match /logs/{logId} {
          allow list, get: if isOwner(uid);
          allow create: if isOwner(uid);
        }
      }
    }

    match /igLookup/{igId} {
      allow create, update: if isSignedIn()
        && incoming().uid == request.auth.uid
        && incoming().accountId is string
        && incoming().pageAccessToken is string
        && incoming().pageAccessToken.size() <= 4096;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
