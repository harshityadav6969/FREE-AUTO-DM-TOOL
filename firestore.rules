rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- SHARED HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- ENTITY VALIDATIONS ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'subscriptionTier', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email is string
        && data.subscriptionTier in ['FREE', 'PRO', 'ENTERPRISE']
        && data.createdAt is string;
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['instagramId', 'pageAccessToken'])
        && data.instagramId is string && data.instagramId.size() <= 128
        && data.pageAccessToken is string && data.pageAccessToken.size() <= 1024;
    }

    function isValidRule(data) {
      return data.keys().hasAll(['triggerKeyword', 'resource'])
        && data.triggerKeyword is string && data.triggerKeyword.size() <= 64
        && data.resource is string && data.resource.size() <= 512;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['eventType', 'timestamp'])
        && data.eventType in ['COMMENT_REPLIED', 'DM_SENT', 'RESOURCE_DELIVERED', 'FOLLOW_PROMPT', 'ERROR']
        && data.timestamp == request.time;
    }

    // --- ROUTES ---

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUser(incoming());
      allow update: if isOwner(uid) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
      );

      match /accounts/{accountId} {
        allow list, get: if isOwner(uid);
        allow create: if isOwner(uid) && isValidAccount(incoming()) && isValidId(accountId);
        allow update: if isOwner(uid) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'pageAccessToken', 'verifyToken'])
        );
        allow delete: if isOwner(uid);

        match /media/{mediaId} {
          allow list, get: if isOwner(uid);
          allow write: if isOwner(uid);
        }

        match /rules/{ruleId} {
          allow list, get: if isOwner(uid);
          allow create: if isOwner(uid) && isValidRule(incoming()) && isValidId(ruleId);
          allow update: if isOwner(uid) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['triggerKeyword', 'resource', 'requireFollow', 'isActive', 'delaySeconds'])
          );
          allow delete: if isOwner(uid);
        }

        match /logs/{logId} {
          allow list, get: if isOwner(uid);
          allow create: if isOwner(uid) && isValidLog(incoming());
        }

        match /templates/{templateId} {
          allow list, get: if isOwner(uid);
          allow write: if isOwner(uid);
        }
      }
    }
  }
}
