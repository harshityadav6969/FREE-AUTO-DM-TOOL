{
  "framework": "vite",
  "functions": {
    "api/ig-exchange.ts": { "maxDuration": 15 },
    "api/ig/me.ts": { "maxDuration": 10 },
    "api/ig/media.ts": { "maxDuration": 20 },
    "api/ig/refresh.ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/ig/refresh", "schedule": "0 4 * * *" }],
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/auth/:path*" },
    { "source": "/webhook", "destination": "/api/webhook" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
